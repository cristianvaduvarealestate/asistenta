# ==============================================================================
# ASISTENȚĂ IMOBILIARE ȘI ASIGURĂRI — CONFIGURAȚIE MEDIU (.env / .dev.vars)
# ==============================================================================
# Pentru Cloudflare Workers, secretele de producție se configurează prin:
#   npx wrangler secret put <NUME_SECRET>
#
# Pentru testare locală cu Wrangler dev, copiază acest fișier în .env sau .dev.vars.
# Nu introduce și nu comite niciodată valori secrete reale în Git!
# ==============================================================================

# URL-ul canonic public de producție
PUBLIC_SITE_URL=https://asistenta.cristianvaduva.com

# ------------------------------------------------------------------------------
# 1. BAZA DE DATE CLOUDFLARE D1 (ȘI FALLBACK LOCAL SQLITE)
# ------------------------------------------------------------------------------
# În Cloudflare Workers, baza D1 este legată prin binding-ul 'DB' din wrangler.jsonc.
# Database Name: asistenta-db
# Database ID: 197c9ab9-dac8-4864-92a8-fc9555c060a8
# Pentru scripturi standalone Node.js, calea locală SQLite opțională:
SQLITE_DB_PATH=./data/helpdesk.sqlite

# ------------------------------------------------------------------------------
# 2. AUTENTIFICARE ȘI ADMINISTRARE (WRANGLER SECRETS)
# ------------------------------------------------------------------------------
# Numele de utilizator al administratorului
ADMIN_USERNAME=cristian

# Parola hash-uită (generată prin: npm run admin:hash -- "parola_aleasa")
# Format: salt_hex:derived_scrypt_hex
# Comandă Cloudflare: npx wrangler secret put ADMIN_PASSWORD_HASH
ADMIN_PASSWORD_HASH=

# Cheie secretă pentru semnarea cookie-urilor de sesiune admin (HMAC-SHA256)
# Minimum 32 de caractere. Generează cu: openssl rand -hex 32
# Comandă Cloudflare: npx wrangler secret put SESSION_SECRET
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 3. ENDPOINT CRON ȘI PROCESARE JOBURI (WRANGLER SECRETS)
# ------------------------------------------------------------------------------
# Token secret de autorizare pentru endpoint-ul POST /api/jobs/tick
# Minimum 32 de caractere. Generează cu: openssl rand -hex 32
# Comandă Cloudflare: npx wrangler secret put JOBS_SECRET
JOBS_SECRET=

# ------------------------------------------------------------------------------
# 4. ALERTE TELEGRAM (NOTIFICĂRI CONSULTANT - WRANGLER SECRETS)
# ------------------------------------------------------------------------------
# Token-ul botului generat de @BotFather pe Telegram
# Comandă Cloudflare: npx wrangler secret put TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=

# ID-ul conversației sau grupului/canalului privat unde se primesc alertele
# Comandă Cloudflare: npx wrangler secret put TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 5. RETENȚIE OPERAȚIONALĂ GDPR (ZILE)
# ------------------------------------------------------------------------------
RETENTION_DAYS=730
