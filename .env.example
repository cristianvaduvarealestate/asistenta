# ==============================================================================
# INSURANCE HELP DESK — CONFIGURAȚIE MEDIU (.env)
# ==============================================================================
# Copiază acest fișier în .env și completează valorile pentru mediul tău.
# Nu introduce și nu comite niciodată valori secrete în Git!
# ==============================================================================

# Portul local pe care rulează serverul Node.js (implicit 3010)
PORT=3010
NODE_ENV=production

# URL-ul local intern (utilizat de server pentru referințe locale)
SITE_URL=http://localhost:3010

# URL-ul canonic public de producție (folosit în meta tag-uri, sitemap și canonicals)
PUBLIC_SITE_URL=https://helpdesk.cristianvaduva.com

# ------------------------------------------------------------------------------
# 1. BAZA DE DATE SQLITE (PERSISTENȚĂ)
# ------------------------------------------------------------------------------
# Calea absolută către fișierul SQLite pe serverul VPS.
# Asigură-te că directorul părinte are permisiuni de scriere pentru utilizatorul aplicației.
# Exemplu producție: /var/lib/insurance-helpdesk/helpdesk.sqlite
# Dacă este lăsat gol, va fi folosit implicit: ./data/helpdesk.sqlite
SQLITE_DB_PATH=/var/lib/insurance-helpdesk/helpdesk.sqlite

# ------------------------------------------------------------------------------
# 2. AUTENTIFICARE ȘI ADMINISTRARE
# ------------------------------------------------------------------------------
# Numele de utilizator al administratorului
ADMIN_USERNAME=cristian

# Parola hash-uită (generată prin: npm run admin:hash -- "parola_aleasa")
# Format: salt_hex:derived_scrypt_hex
ADMIN_PASSWORD_HASH=

# Cheie secretă pentru semnarea cookie-urilor de sesiune admin (HMAC-SHA256)
# Trebuie să aibă minimum 32 de caractere. Generează cu: openssl rand -hex 32
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 3. ENDPOINT CRON ȘI PROCESARE JOBURI (SEPARAT DE SESSION_SECRET)
# ------------------------------------------------------------------------------
# Token secret de autorizare pentru endpoint-ul POST /api/jobs/tick
# Trebuie să aibă minimum 32 de caractere. Generează cu: openssl rand -hex 32
JOBS_SECRET=

# ------------------------------------------------------------------------------
# 4. ALERTE TELEGRAM (NOTIFICĂRI CONSULTANT)
# ------------------------------------------------------------------------------
# Token-ul botului generat de @BotFather pe Telegram
TELEGRAM_BOT_TOKEN=

# ID-ul conversației sau grupului/canalului privat unde se primesc alertele
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 5. RETENȚIE OPERAȚIONALĂ GDPR (ZILE)
# ------------------------------------------------------------------------------
# Perioada propusă de păstrare a solicitărilor în baza de date (implicit 730 zile = 2 ani)
RETENTION_DAYS=730

# ------------------------------------------------------------------------------
# 6. REPLICARE OFF-SITE (OPȚIONAL: LITESTREAM)
# ------------------------------------------------------------------------------
# Folosit doar dacă se activează streaming-ul către Cloudflare R2 sau S3
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# CLOUDFLARE_ACCOUNT_ID=
